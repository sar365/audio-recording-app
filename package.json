{
  "name": "audio-recording-app",
  "private": true,
  "version": "1.0.0",
  "description": "Cross-platform desktop audio recorder for selected system audio and input devices.",
  "author": {
    "name": "DJ Companion",
    "email": "2.16967392e+08+sar365@users.noreply.github.com"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "main": "electron/main.cjs",
  "desktopName": "com.sar365.djcompanion",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:build": "vite build --mode desktop --base=./ && electron-builder --publish never",
    "desktop:linux": "vite build --mode desktop --base=./ && electron-builder --linux --publish never",
    "desktop:win": "vite build --mode desktop --base=./ && electron-builder --win --publish never",
    "desktop:mac": "vite build --mode desktop --base=./ && electron-builder --mac --publish never",
    "format": "oxfmt"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },
  "build": {
    "appId": "com.sar365.djcompanion",
    "productName": "DJ Companion",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "artifactName": "DJ-Companion-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "DJ Companion needs microphone access to record audio inputs you select.",
        "NSAudioCaptureUsageDescription": "DJ Companion needs audio capture access to record the screen or window audio source you select."
      }
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "artifactName": "DJ-Companion-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "AudioVideo",
      "syncDesktopName": true,
      "maintainer": "DJ Companion <2.16967392e+08+sar365@users.noreply.github.com>",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "artifactName": "DJ-Companion-${version}-${arch}.${ext}"
    }
  }
}
